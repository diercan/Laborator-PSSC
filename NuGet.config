<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixează sursa de pachete NuGet pentru acest depozit, indiferent de configurația globală a mașinii
  (de exemplu un feed intern al unei companii). Fără acest fișier, restaurarea cu Central Package
  Management poate eșua cu NU1507 atunci când mai multe surse sunt înregistrate global.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
