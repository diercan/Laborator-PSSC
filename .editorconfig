# Stil de cod comun pentru toate laboratoarele PSSC.
# Documentație: https://learn.microsoft.com/dotnet/fundamentals/code-analysis/code-style-rule-options
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,slnx,props,targets,csproj}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Organizare
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Expresii și declarații
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Diagnostice
dotnet_diagnostic.IDE0005.severity = warning     # using-uri inutile
dotnet_diagnostic.IDE0161.severity = warning     # namespace la nivel de fișier
dotnet_diagnostic.IDE0055.severity = suggestion  # formatarea nu trebuie să oprească build-ul studenților
dotnet_diagnostic.CA1848.severity = suggestion   # LoggerMessage – folosit în infrastructură, nu impus peste tot
dotnet_diagnostic.CA1062.severity = none         # validarea argumentelor publice – prea zgomotoasă pentru un laborator
