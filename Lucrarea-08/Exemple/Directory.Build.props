<Project>
  <!--
    Configurație comună pentru toate proiectele din acest laborator.
    Fișierul este identic în toate laboratoarele (verificat de tools/Check-LabConsistency.ps1).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Avertismentele de audit NuGet rămân vizibile, dar un advisory nou nu trebuie să blocheze build-ul studenților. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Documentația XML alimentează generatorul OpenAPI din .NET 10 și permite regulii IDE0005 să ruleze la build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- CA1716: tipuri precum Result/Option/Error/Namespace preiau intenționat numele lor din F# (Wlaschin); depozitul e doar C#. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <!-- CA1708: fals-pozitiv al analizorului pentru mai multe blocuri "extension(...)" (C# 14) în aceeași clasă statică. -->
    <NoWarn>$(NoWarn);CA1708</NoWarn>
    <!-- CA1711: IEventHandler<T> este o interfață de gestionare a evenimentelor, nu un delegat "...EventHandler". -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Același identificator în toate laboratoarele: un connection string setat o singură dată per tip de host. -->
    <UserSecretsId>PSSC.$(MSBuildProjectName)</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
</Project>
