<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Worker care ascultă evenimentele de note publicate și le tratează în contextul cazării.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Azure" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Examples.Contracts\Examples.Contracts.csproj" />
    <ProjectReference Include="..\Examples.Events.ServiceBus\Examples.Events.ServiceBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk (spre deosebire de Microsoft.NET.Sdk.Web) nu copiază appsettings*.json automat. -->
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
